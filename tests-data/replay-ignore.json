{
  "rules": [
    {"route": "POST /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": "metadata.name", "mode": "map", "reason": "generated dashboard uid (generateName); later rows use it in URLs"},
    {"route": "POST /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": "metadata.uid", "mode": "map", "reason": "generated Kubernetes object uid"},
    {"route": "POST /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": "metadata.resourceVersion", "mode": "value", "reason": "write time in microseconds"},
    {"route": "POST /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": "metadata.creationTimestamp", "mode": "value", "reason": "write time"},
    {"route": "POST /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": ["metadata", "labels", "grafana.app/deprecatedInternalID"], "mode": "value", "reason": "generated snowflake id"},
    {"route": "POST /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": "metadata.managedFields.*.time", "mode": "value", "reason": "write time"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*/dto", "path": "metadata.uid", "mode": "map", "reason": "generated Kubernetes object uid"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*/dto", "path": "metadata.resourceVersion", "mode": "value", "reason": "write time in microseconds"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*/dto", "path": "metadata.creationTimestamp", "mode": "value", "reason": "write time"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*/dto", "path": ["metadata", "labels", "grafana.app/deprecatedInternalID"], "mode": "value", "reason": "generated snowflake id"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*/dto", "path": "metadata.managedFields.*.time", "mode": "value", "reason": "write time"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*/dto", "path": ["metadata", "annotations", "grafana.app/createdBy"], "mode": "value", "reason": "user:<uid> of the seeding admin; the user uid is random per install"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*/dto", "path": ["metadata", "annotations", "grafana.app/updatedBy"], "mode": "value", "reason": "user:<uid> of the seeding admin; the user uid is random per install"},
    {"route": "GET /apis/dashboard.grafana.app/v0alpha1/namespaces/*/search", "path": "hits.*.score", "mode": "value", "reason": "bleve BM25 relevance score; grafana-rs scores by its own formula that keeps the same order"},
    {"route": "GET /apis/dashboard.grafana.app/v0alpha1/namespaces/*/search", "path": "maxScore", "mode": "value", "reason": "bleve BM25 relevance score"},
    {"route": "GET /apis/dashboard.grafana.app/v0alpha1/namespaces/*/search", "path": "queryCost", "mode": "value", "reason": "bleve query cost counter"},
    {"route": "POST /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": "metadata.managedFields.*.manager", "mode": "value", "reason": "the apiserver names the field manager after the User-Agent, which replay.mjs does not send"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*/dto", "path": "metadata.managedFields.*.manager", "mode": "value", "reason": "the apiserver names the field manager after the User-Agent, which replay.mjs does not send"},
    {"route": "POST /api/query-history", "path": "result.uid", "mode": "map", "reason": "generated query history uid"},
    {"route": "POST /api/query-history", "path": "result.createdAt", "mode": "value", "reason": "write time"},
    {"route": "POST /api/folders", "path": "id", "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "POST /api/folders", "path": "created", "mode": "value", "reason": "write time"},
    {"route": "POST /api/folders", "path": "updated", "mode": "value", "reason": "write time"},
    {"route": "GET /api/folders/*", "path": "id", "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /api/folders/*", "path": "created", "mode": "value", "reason": "write time"},
    {"route": "GET /api/folders/*", "path": "updated", "mode": "value", "reason": "write time"},
    {"route": "GET /api/folders", "path": "*.id", "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /apis/folder.grafana.app/v1/namespaces/*/folders/*", "path": "metadata.uid", "mode": "value", "reason": "generated Kubernetes object uid"},
    {"route": "GET /apis/folder.grafana.app/v1/namespaces/*/folders/*", "path": "metadata.resourceVersion", "mode": "value", "reason": "write time in microseconds"},
    {"route": "GET /apis/folder.grafana.app/v1/namespaces/*/folders/*", "path": "metadata.creationTimestamp", "mode": "value", "reason": "write time"},
    {"route": "GET /apis/folder.grafana.app/v1/namespaces/*/folders/*", "path": ["metadata", "labels", "grafana.app/deprecatedInternalID"], "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /apis/folder.grafana.app/v1/namespaces/*/folders/*", "path": "metadata.managedFields.*.time", "mode": "value", "reason": "write time"},
    {"route": "GET /apis/folder.grafana.app/v1/namespaces/*/folders/*", "path": ["metadata", "annotations", "grafana.app/createdBy"], "mode": "value", "reason": "user:<uid> of the writing user; the user uid is random per install"},
    {"route": "GET /apis/folder.grafana.app/v1/namespaces/*/folders/*", "path": ["metadata", "annotations", "grafana.app/updatedBy"], "mode": "value", "reason": "user:<uid> of the writing user; the user uid is random per install"},
    {"route": "POST /api/dashboards/db", "path": "id", "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "POST /api/dashboards/db", "path": "uid", "mode": "map", "reason": "generated dashboard uid (generateName \"a\"); later rows use it"},
    {"route": "GET /api/dashboards/uid/*", "path": "dashboard.id", "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /api/dashboards/uid/*", "path": "meta.folderId", "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /api/dashboards/uid/*", "path": "meta.created", "mode": "value", "reason": "write time"},
    {"route": "GET /api/dashboards/uid/*", "path": "meta.updated", "mode": "value", "reason": "write time"},
    {"route": "GET /api/dashboards/uid/*/versions", "path": "versions.*.dashboardId", "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /api/dashboards/uid/*/versions", "path": "versions.*.created", "mode": "value", "reason": "write time"},
    {"route": "GET /api/dashboards/uid/*/versions/*", "path": "dashboardId", "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /api/dashboards/uid/*/versions/*", "path": "created", "mode": "value", "reason": "write time"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*", "path": "metadata.uid", "mode": "value", "reason": "generated Kubernetes object uid"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*", "path": "metadata.resourceVersion", "mode": "value", "reason": "write time in microseconds"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*", "path": "metadata.creationTimestamp", "mode": "value", "reason": "write time"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*", "path": ["metadata", "labels", "grafana.app/deprecatedInternalID"], "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*", "path": "metadata.managedFields.*.time", "mode": "value", "reason": "write time"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*", "path": ["metadata", "annotations", "grafana.app/createdBy"], "mode": "value", "reason": "user:<uid> of the writing user; the user uid is random per install"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*", "path": ["metadata", "annotations", "grafana.app/updatedBy"], "mode": "value", "reason": "user:<uid> of the writing user; the user uid is random per install"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*", "path": ["metadata", "annotations", "grafana.app/updatedTimestamp"], "mode": "value", "reason": "write time"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards/*/dto", "path": ["metadata", "annotations", "grafana.app/updatedTimestamp"], "mode": "value", "reason": "write time"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": "metadata.resourceVersion", "mode": "value", "reason": "write time in microseconds"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": "items.*.metadata.uid", "mode": "value", "reason": "generated Kubernetes object uid"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": "items.*.metadata.resourceVersion", "mode": "value", "reason": "write time in microseconds"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": "items.*.metadata.creationTimestamp", "mode": "value", "reason": "write time"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": ["items", "*", "metadata", "labels", "grafana.app/deprecatedInternalID"], "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": "items.*.metadata.managedFields.*.time", "mode": "value", "reason": "write time"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": ["items", "*", "metadata", "annotations", "grafana.app/createdBy"], "mode": "value", "reason": "user:<uid> of the writing user; the user uid is random per install"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": ["items", "*", "metadata", "annotations", "grafana.app/updatedBy"], "mode": "value", "reason": "user:<uid> of the writing user; the user uid is random per install"},
    {"route": "GET /apis/dashboard.grafana.app/v1/namespaces/*/dashboards", "path": ["items", "*", "metadata", "annotations", "grafana.app/updatedTimestamp"], "mode": "value", "reason": "write time"},
    {"route": "GET /api/search", "path": "*.id", "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /api/search", "path": "*.folderId", "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /api/annotations", "path": "*.dashboardId", "mode": "value", "reason": "generated snowflake id (grafana.app/deprecatedInternalID)"},
    {"route": "GET /api/annotations", "path": "*.created", "mode": "value", "reason": "write time"},
    {"route": "GET /api/annotations", "path": "*.updated", "mode": "value", "reason": "write time"},
    {"route": "GET /api/annotations", "path": "*.userUID", "mode": "value", "reason": "uid of the admin user; random per install"},
    {"route": "GET /api/annotations", "path": "*.avatarUrl", "mode": "value", "reason": "sha256 of the admin email; Grafana ships admin@localhost, the seed may differ"}
  ]
}
